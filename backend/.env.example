# TailorMade Backend — Required Environment Variables
# Copy to .env and fill in real values.
#
# Variables marked REQUIRED have no default — the server will refuse
# to start if they are missing. Optional variables have safe defaults.

# === AI Generation ===

# REQUIRED — fal.ai API key for image generation (FLUX.1 Kontext [pro])
FAL_KEY=your-fal-key

# REQUIRED — Anthropic API key for content safety + scene planning (Claude Haiku)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Legacy optional tuning values — normally leave blank/default.
CUSTOM_LORA_URL=
LORA_SCALE=1.0

# === Firebase ===

# REQUIRED — Firebase project ID (matches frontend Firebase project)
FIREBASE_PROJECT_ID=tailormade-coloring-book

# Service account credentials. Set ONE of these:
#   FIREBASE_SERVICE_ACCOUNT_JSON — inline JSON string (used in Railway prod)
#   FIREBASE_SERVICE_ACCOUNT_PATH — path to service-account .json file (used in local dev)
# When both are set, FIREBASE_SERVICE_ACCOUNT_JSON wins.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./app/tailormade-coloring-book-firebase-adminsdk-fbsvc-677adebcf5.json

# === Cloudflare R2 ===

# REQUIRED — image and PDF storage (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tailormadecoloringbook
R2_PUBLIC_URL=https://your-public-r2-domain

# === Stripe ===

# Mode: "test" or "live". Admin can also toggle this at runtime via Firestore.
STRIPE_MODE=test

# Test keys (used when STRIPE_MODE=test)
STRIPE_TEST_SECRET_KEY=sk_test_your-test-secret-key
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your-test-publishable-key

# Live keys (used when STRIPE_MODE=live)
STRIPE_LIVE_SECRET_KEY=sk_live_your-live-secret-key
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_your-live-publishable-key

# Single webhook secret for both modes — match this to the Railway endpoint
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Price IDs for the three SKUs
STRIPE_FAMILY_PRICE_ID=price_your-family-price-id
STRIPE_TEACHER_PRICE_ID=price_your-teacher-price-id
STRIPE_SINGLE_PRICE_ID=price_your-single-price-id

# Where the Stripe Customer Portal redirects users back to after billing edits
STRIPE_PORTAL_RETURN_URL=https://tailormadecoloringbook.app/billing

# === App Config ===

# "development" or "production". Development unlocks the dev-test-token auth bypass.
APP_ENV=development
DEBUG=false

# Comma-separated Firebase UIDs that get admin dashboard access
ADMIN_UIDS=

# Optional X-Admin-Token header value for protected admin operations if enabled
ADMIN_SECRET_TOKEN=

# Optional — Sentry DSN for backend error tracking. Leave empty to disable.
SENTRY_DSN=

# === Resend Email ===
# Optional — transactional email. If unset, email sending is skipped.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@tailormadecoloringbook.app
RESEND_FROM_NAME=TailorMade Coloring Book

# === Tier Limit Overrides (optional) ===
# All have sensible defaults in config.py. Override only if you change pricing.
FREE_LIFETIME_LIMIT=1
FREE_MAX_PAGES=6
SINGLE_MAX_PAGES=15
FAMILY_MONTHLY_LIMIT=12
FAMILY_MAX_PAGES=15
TEACHER_MONTHLY_LIMIT=25
TEACHER_MAX_PAGES=12
MAX_PAGES=15
MAX_CONCURRENT_FAL_CALLS=5

# === Cost Tracking Overrides (optional) ===
COST_FLUX_LORA=0.04
COST_HAIKU_INPUT=0.000001
COST_HAIKU_OUTPUT=0.000005
