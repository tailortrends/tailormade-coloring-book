# Frontend API
# Local dev uses localhost. Production should set this in Vercel; if omitted,
# the app falls back to the Railway production backend URL.
VITE_API_URL=http://localhost:8000

# Firebase browser config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Stripe price IDs used by the pricing page
VITE_STRIPE_FAMILY_PRICE_ID=price_your_family_price_id
VITE_STRIPE_TEACHER_PRICE_ID=price_your_teacher_price_id
VITE_STRIPE_SINGLE_PRICE_ID=price_your_single_price_id

# Optional observability/admin UI
VITE_SENTRY_DSN=
VITE_ADMIN_UIDS=comma-separated-firebase-uids
